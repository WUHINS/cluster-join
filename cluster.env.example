# cluster-join.sh 参数示例
#
# 用法：复制到 /etc/cluster-join/cluster.env（脚本会自动读写该文件）
#         sudo mkdir -p /etc/cluster-join
#         sudo cp cluster.env.example /etc/cluster-join/cluster.env
#         sudo chmod 600 /etc/cluster-join/cluster.env
#         sudo sh cluster-join.sh --all --yes
#
# 格式说明：每行 KEY=VALUE，值不要加引号（脚本按「第一个等号」切分，不做 shell 求值）。
#          值里可以包含空格、=、单引号，例如 ET_PEERS、密码。
#          命令行参数与环境变量的优先级高于本文件。
#
# 如果偏好用 shell 环境变量，请显式 export（注意含空格的值必须加引号）：
#         export KOMARI_AD_KEY='AD-XXXX'
#         export ET_PEERS='tcp://1.2.3.4:11010 udp://1.2.3.4:11010'
#         sudo -E sh cluster-join.sh --all --yes

# ---------- 通用 ----------
# 需要 root，脚本会自动 sudo 提权
#
# 注意：CLUSTER_JOIN_YES / CLUSTER_JOIN_NO_TTY / CLUSTER_JOIN_FORCE_INTERACTIVE
#      属于「运行控制变量」，只认环境变量，写在本文件里不会生效。
#      同理消息语言用 CLUSTER_JOIN_LANG=zh|en（批量脚本用 CLUSTER_BATCH_LANG），
#      或直接加 --lang zh|en。
#      语言默认策略：交互式 TTY 一律英文；非 TTY 按系统 locale（zh* 用中文）。
#      建议无人值守时这样调用： sudo sh cluster-join.sh --all --yes

# GitHub 加速前缀；置空则使用内置镜像列表
GH_PROXY=https://ghfast.top/

# ---------- Komari 监控面板 ----------
KOMARI_ENDPOINT=https://komari.example.com
# 说明：AD Key / Token 属于密钥，本存档故意不保存它们。
#       首次安装时用命令行传一次 AD Key 完成注册即可：
#         sudo sh cluster-join.sh --komari-only --yes \
#             --komari-ad-key 'AD-XXXX' -e https://komari.example.com
#       注册得到的节点令牌会写进 /opt/komari/agent.json（权限 600），
#       服务单元只通过 --config 引用它，之后重跑无需再提供 AD Key。
#
# 如需把密钥写进本文件也可以（自己取消注释），但要注意文件权限：
# KOMARI_AD_KEY=AD-XXXXXXXXXXXXXXXX
# KOMARI_TOKEN=
#
# 上报间隔（秒），默认 1
KOMARI_INTERVAL=1
# 安全加固：禁用探针的远程执行 / Web SSH
KOMARI_DISABLE_WEB_SSH=1

# ---------- EasyTier 组网 ----------
# web = Web 控制台托管（推荐） | peer = 共享节点/P2P | server = 本机做共享节点
ET_MODE=web

# web 模式：自建控制台写完整地址，官方控制台只写用户名
ET_CONFIG_SERVER=udp://10.0.0.1:22020/admin
# 固定机器标识，重装/迁移后仍保持同一节点身份（可留空自动生成）
ET_MACHINE_ID=

# peer 模式参数（ET_MODE=peer 时生效）
ET_NETWORK_NAME=mynet-prod
ET_NETWORK_SECRET=change-me-to-a-strong-secret
ET_PEERS=tcp://1.2.3.4:11010 udp://1.2.3.4:11010
ET_IPV4=
ET_DHCP=1

# 需要固定 IP 时：
# ET_IPV4=10.126.126.7
# ET_DHCP=0

# server 模式监听端口
ET_LISTEN_PORT=11010

# ---------- Web 控制台服务端（--web-only 时使用）----------
WEB_DEPLOY=binary
WEB_PORT=11211
WEB_CFG_PORT=22020
WEB_CFG_PROTO=udp
# 默认 http://<本机IP>:<WEB_PORT>
WEB_API_HOST=
